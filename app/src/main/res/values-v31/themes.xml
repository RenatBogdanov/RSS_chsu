<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RSS_chsu" parent="Base.Theme.RSS_chsu">
        <!-- Transparent system bars for edge-to-edge -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- Android 12+ System Splash Screen Attributes -->
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/padded_icon</item>
    </style>
</resources>
