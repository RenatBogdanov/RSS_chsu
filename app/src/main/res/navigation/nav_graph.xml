<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/FirstFragment">

    <fragment
        android:id="@+id/FirstFragment"
        android:name="com.example.rss_chsu.FirstFragment"
        android:label="@string/first_fragment_label"
        tools:layout="@layout/fragment_feed">

        <action
            android:id="@+id/action_FirstFragment_to_SecondFragment"
            app:destination="@id/SecondFragment" />
    </fragment>
    <fragment
        android:id="@+id/SecondFragment"
        android:name="com.example.rss_chsu.SecondFragment"
        android:label="@string/second_fragment_label"
        tools:layout="@layout/fragment_sources">

        <action
            android:id="@+id/action_SecondFragment_to_FirstFragment"
            app:destination="@id/FirstFragment" />

        <action
            android:id="@+id/action_SecondFragment_to_NotesFragment"
            app:destination="@id/NotesFragment" />
    </fragment>

    <fragment
        android:id="@+id/NotesFragment"
        android:name="com.example.rss_chsu.NotesFragment"
        android:label="Заметки"
        tools:layout="@layout/fragment_notes" />
</navigation>